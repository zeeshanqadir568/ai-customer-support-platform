# Copy this file to .env and fill in the values you need.
# .env is git-ignored. start.ps1 / start.bat / `make env` create it for you.

# ─────────────────────────────────────────────────────────────────────
# REQUIRED to use the AI chat (POST /chat and the chat box in the web UI)
# ─────────────────────────────────────────────────────────────────────
# Your Anthropic API key. Get one at https://console.anthropic.com/.
# Without it the server still starts and the web UI, support queue, and
# ticket APIs all work - only the chat agent returns 503.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# OPTIONAL - sensible defaults are baked in; override only if you want to
# ─────────────────────────────────────────────────────────────────────

# Model the support agent uses. Default: claude-opus-5
# Cheaper for high volume: claude-sonnet-5, claude-haiku-4-5
MODEL=claude-opus-5

# Hard cap on agent reason->act iterations before it auto-escalates to a human.
MAX_AGENT_STEPS=6

# SQLite file for demo customers, orders and tickets. Deleted safely by `make clean`.
DATABASE_PATH=support.db

# Seed demo customers/orders on startup (idempotent).
SEED_ON_STARTUP=true

# Server bind settings read by `python -m app` (not by plain `uvicorn`).
# HOST=127.0.0.1
# PORT=8000
# RELOAD=0
