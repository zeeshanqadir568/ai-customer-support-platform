# Copy to .env and fill in. .env is git-ignored.

# Anthropic API key. Without it, POST /chat returns 503 (tools + tickets still work).
ANTHROPIC_API_KEY=

# Model used by the support agent. Defaults to claude-opus-5.
# Cheaper options for high volume: claude-sonnet-5, claude-haiku-4-5
MODEL=claude-opus-5

# Hard cap on agent reason->act iterations before auto-escalating to a human.
MAX_AGENT_STEPS=6

# SQLite file for customers, orders and tickets.
DATABASE_PATH=support.db

# Seed demo customers/orders on startup.
SEED_ON_STARTUP=true
